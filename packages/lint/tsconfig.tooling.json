{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "allowJs": true,
        "allowImportingTsExtensions": true,
        "strict": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "*.ts",
        "bin/*.js"
    ]
}
