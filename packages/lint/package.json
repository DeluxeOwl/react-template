{
    "name": "@deluxeowl/lint",
    "version": "0.4.0",
    "type": "module",
    "private": false,
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DeluxeOwl/react-template.git",
        "directory": "packages/lint"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "zshy": {
        "exports": {
            ".": "./src/index.ts",
            "./react": "./src/react.ts",
            "./oxlint": "./src/oxlint/index.ts",
            "./ast-grep": "./src/ast-grep.ts"
        },
        "cjs": false
    },
    "files": [
        "dist",
        "bin",
        "vendor",
        "ast-grep",
        "dprint.jsonc"
    ],
    "scripts": {
        "build": "zshy",
        "lint:oxlint": "oxlint-fix .",
        "lint:eslint": "eslint --fix .",
        "typecheck": "tsc --noEmit",
        "test": "vitest --run --passWithNoTests --reporter=tree"
    },
    "dependencies": {
        "@babel/helper-validator-identifier": "^7.28.5",
        "@eslint-community/eslint-utils": "^4.9.1",
        "@eslint-react/eslint-plugin": "^5.7.1",
        "@tanstack/eslint-plugin-query": "^5.100.9",
        "@typescript-eslint/types": "^8.59.1",
        "@typescript-eslint/utils": "^8.59.1",
        "@vitest/eslint-plugin": "^1.6.16",
        "change-case": "^5.4.4",
        "clean-regexp": "^1.0.0",
        "eslint-config-flat-gitignore": "^2.3.0",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-better-tailwindcss": "^4.5.0",
        "eslint-plugin-import-x": "^4.16.2",
        "eslint-plugin-import-zod": "^1.2.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "eslint-plugin-react-render-types": "^0.7.6",
        "eslint-plugin-sweepit": "^0.0.23",
        "eslint-plugin-unused-imports": "^4.3.0",
        "eslint-visitor-keys": "^4.2.1",
        "espree": "^10.4.0",
        "estraverse": "^5.3.0",
        "jsesc": "^3.1.0",
        "natural-orderby": "^5.0.0",
        "regexp-tree": "^0.1.27",
        "typescript-eslint": "^8.59.1"
    },
    "peerDependencies": {
        "eslint": ">=10",
        "oxlint": "~1.86.0",
        "oxlint-tsgolint": ">=7.0.2003",
        "typescript": ">=5.9"
    },
    "devDependencies": {
        "@types/node": "^25.6.0",
        "@typescript-eslint/rule-tester": "^8.59.1",
        "eslint": "^10.3.0",
        "vitest": "^4.1.5",
        "zshy": "^0.7.3"
    },
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "default": "./dist/react.js"
        },
        "./oxlint": {
            "types": "./dist/oxlint/index.d.ts",
            "default": "./dist/oxlint/index.js"
        },
        "./ast-grep": {
            "types": "./dist/ast-grep.d.ts",
            "default": "./dist/ast-grep.js"
        }
    },
    "bin": {
        "oxlint-fix": "./bin/oxlint-fix.js"
    }
}
