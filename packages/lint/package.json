{
    "name": "@deluxeowl/lint",
    "version": "0.4.0",
    "type": "module",
    "private": false,
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DeluxeOwl/react-template.git",
        "directory": "packages/lint"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "zshy": {
        "exports": {
            ".": "./src/index.ts",
            "./react": "./src/react.ts",
            "./oxlint": "./src/oxlint/index.ts",
            "./oxlint/custom-plugin": "./src/custom/oxlint-plugin.ts",
            "./ast-grep": "./src/ast-grep.ts"
        },
        "cjs": false
    },
    "files": [
        "dist",
        "bin",
        "vendor",
        "ast-grep",
        "dprint.jsonc"
    ],
    "scripts": {
        "build": "zshy",
        "lint:oxlint": "oxlint-fix .",
        "lint:eslint": "eslint --fix .",
        "typecheck": "tsc --noEmit",
        "test": "vitest --run --passWithNoTests --reporter=tree"
    },
    "dependencies": {
        "@babel/core": "^7.29.0",
        "@babel/helper-validator-identifier": "^7.28.5",
        "@babel/parser": "^7.29.0",
        "@eslint-community/eslint-utils": "^4.9.1",
        "@eslint-react/eslint-plugin": "^5.7.1",
        "@tanstack/eslint-plugin-query": "^5.100.9",
        "@typescript-eslint/parser": "^8.59.1",
        "@typescript-eslint/scope-manager": "^8.59.1",
        "@typescript-eslint/types": "^8.59.1",
        "@typescript-eslint/utils": "^8.59.1",
        "@vitest/eslint-plugin": "^1.6.16",
        "change-case": "^5.4.4",
        "clean-regexp": "^1.0.0",
        "debug": "^4.4.3",
        "escape-string-regexp": "^4.0.0",
        "eslint-config-flat-gitignore": "^2.3.0",
        "eslint-import-context": "^0.1.9",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-better-tailwindcss": "^4.5.0",
        "eslint-plugin-react-render-types": "^0.7.6",
        "eslint-plugin-sweepit": "^0.0.23",
        "eslint-visitor-keys": "^4.2.1",
        "espree": "^10.4.0",
        "estraverse": "^5.3.0",
        "esutils": "^2.0.3",
        "globals": "^16.5.0",
        "hermes-parser": "^0.25.1",
        "is-glob": "^4.0.3",
        "jsesc": "^3.1.0",
        "minimatch": "^10.2.4",
        "natural-orderby": "^5.0.0",
        "regexp-tree": "^0.1.27",
        "semver": "^7.7.4",
        "stable-hash-x": "^0.2.0",
        "typescript-eslint": "^8.59.1",
        "unrs-resolver": "^1.11.1",
        "zod": "^4.4.3",
        "zod-validation-error": "^4.0.2"
    },
    "peerDependencies": {
        "eslint": ">=10",
        "oxlint": "~1.86.0",
        "oxlint-tsgolint": ">=7.0.2003",
        "typescript": ">=5.9"
    },
    "devDependencies": {
        "@types/node": "^25.6.0",
        "@typescript-eslint/rule-tester": "^8.59.1",
        "eslint": "^10.3.0",
        "vitest": "^4.1.5",
        "zshy": "^0.7.3"
    },
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "default": "./dist/react.js"
        },
        "./oxlint": {
            "types": "./dist/oxlint/index.d.ts",
            "default": "./dist/oxlint/index.js"
        },
        "./oxlint/custom-plugin": {
            "types": "./dist/custom/oxlint-plugin.d.ts",
            "default": "./dist/custom/oxlint-plugin.js"
        },
        "./ast-grep": {
            "types": "./dist/ast-grep.d.ts",
            "default": "./dist/ast-grep.js"
        }
    },
    "bin": {
        "oxlint-fix": "./bin/oxlint-fix.js"
    }
}
