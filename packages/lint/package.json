{
    "name": "@deluxeowl/lint",
    "version": "0.7.0",
    "type": "module",
    "private": false,
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DeluxeOwl/react-template.git",
        "directory": "packages/lint"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "zshy": {
        "exports": {
            "./oxlint": "./src/oxlint/index.ts",
            "./oxlint/custom-plugin": "./src/custom/oxlint-plugin.ts"
        },
        "cjs": false
    },
    "files": [
        "dist",
        "bin",
        "vendor",
        "dprint.jsonc"
    ],
    "scripts": {
        "build": "zshy -p tsconfig.lib.json",
        "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.tooling.json",
        "test": "bun vitest-on-node.ts --run --passWithNoTests --reporter=tree",
        "vendor": "bun scripts/vendor/vendor.ts",
        "dump-ast": "node scripts/dump-ast.ts"
    },
    "dependencies": {
        "@babel/core": "^7.29.0",
        "@babel/helper-validator-identifier": "^7.28.5",
        "@babel/parser": "^7.29.0",
        "@eslint/css-tree": "^4.0.3",
        "@oxlint/plugins": "1.86.0",
        "@typescript-eslint/scope-manager": "^8.59.1",
        "@typescript-eslint/types": "^8.59.1",
        "@typescript-eslint/typescript-estree": "^8.59.1",
        "@typescript-eslint/visitor-keys": "^8.59.1",
        "@valibot/to-json-schema": "^1.6.0",
        "birecord": "^0.1.1",
        "change-case": "^5.4.4",
        "clean-regexp": "^1.0.0",
        "compare-versions": "^6.1.1",
        "debug": "^4.4.3",
        "enhanced-resolve": "^5.21.0",
        "escape-string-regexp": "^4.0.0",
        "eslint-import-context": "^0.1.9",
        "eslint-visitor-keys": "^4.2.1",
        "espree": "^10.4.0",
        "estraverse": "^5.3.0",
        "esutils": "^2.0.3",
        "get-tsconfig": "^4.14.0",
        "globals": "^16.5.0",
        "hermes-parser": "^0.25.1",
        "is-bun-module": "^2.0.0",
        "is-glob": "^4.0.3",
        "jiti": "^2.6.1",
        "jsesc": "^3.1.0",
        "minimatch": "^10.2.4",
        "natural-orderby": "^5.0.0",
        "regexp-tree": "^0.1.27",
        "semver": "^7.7.4",
        "stable-hash-x": "^0.2.0",
        "string-ts": "^2.3.1",
        "synckit": "^0.11.12",
        "tailwind-csstree": "^0.3.1",
        "tinyglobby": "^0.2.16",
        "ts-api-utils": "^2.5.0",
        "ts-pattern": "^5.9.0",
        "tsconfig-paths-webpack-plugin": "^4.2.0",
        "unrs-resolver": "^1.11.1",
        "valibot": "^1.3.1",
        "zod": "^4.4.3",
        "zod-validation-error": "^4.0.2"
    },
    "peerDependencies": {
        "oxlint": "~1.86.0",
        "oxlint-tsgolint": ">=7.0.2003",
        "typescript": ">=5.9"
    },
    "devDependencies": {
        "@types/node": "^25.6.0",
        "esbuild": "0.25.12",
        "vitest": "^4.1.5",
        "zshy": "^0.7.3"
    },
    "exports": {
        "./oxlint": {
            "types": "./dist/oxlint/index.d.ts",
            "default": "./dist/oxlint/index.js"
        },
        "./oxlint/custom-plugin": {
            "types": "./dist/custom/oxlint-plugin.d.ts",
            "default": "./dist/custom/oxlint-plugin.js"
        }
    },
    "bin": {
        "oxlint-fix": "./bin/oxlint-fix.js"
    }
}
