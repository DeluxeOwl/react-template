{
    "name": "react-template",
    "private": true,
    "packageManager": "bun@1.3.3",
    "workspaces": [
        "apps/*",
        "packages/*",
        "scripts"
    ],
    "type": "module",
    "devDependencies": {
        "@praha/byethrow-docs": "^0.11.1",
        "@react-template/eslint": "workspace:*",
        "@tanstack/eslint-plugin-query": "^5.100.9",
        "@total-typescript/ts-reset": "^0.6.1",
        "dprint": "^0.54.0",
        "eslint": "^10.3.0",
        "jscpd": "^4.0.9",
        "knip": "^6.11.0",
        "oxlint": "^1.62.0",
        "scaffdog": "^4.1.0",
        "vitest": "^4.1.5"
    },
    "scripts": {
        "dev": "hivemind -T",
        "sync:tsconfig": "bun run scripts/cli.ts sync-tsconfig",
        "lint:oxlint": "bun run --workspaces lint:oxlint",
        "lint:eslint": "bun run --workspaces lint:eslint",
        "lint:sg": "ast-grep scan",
        "format:dprint": "bun run dprint fmt",
        "lint:duplicate": "bun run jscpd -c .jscpd.json",
        "typecheck": "bun run --workspaces typecheck",
        "generate": "bun run scaffdog generate",
        "deadcode": "knip",
        "lint:all": "lefthook run pre-push -f",
        "lint:duplicates": "bun run scripts/cli.ts find-duplicate-functions",
        "outdated": "bun outdated --filter '*'",
        "test": "bun run --workspaces --sequential test"
    },
    "dependencies": {
        "react": "^19.2.5",
        "react-dom": "^19.2.5"
    }
}
