{
    "name": "react-template",
    "private": true,
    "packageManager": "bun@1.3.3",
    "workspaces": {
        "packages": [
            "apps/*",
            "packages/*",
            "scripts"
        ],
        "catalog": {
            "zod": "^4.4.3",
            "ts-pattern": "^5.9.0",
            "@praha/byethrow": "^0.11.1",
            "@praha/error-factory": "^1.4.1",
            "@orpc/contract": "^1.14.1",
            "@orpc/server": "^1.14.1",
            "@orpc/client": "^1.14.1",
            "@orpc/openapi": "^1.14.1",
            "@orpc/zod": "^1.14.1",
            "@orpc/tanstack-query": "^1.14.1",
            "vitest": "^4.1.5",
            "typescript": "^6.0.3",
            "@types/node": "^25.6.0",
            "@types/bun": "^1.3.13"
        }
    },
    "type": "module",
    "devDependencies": {
        "@deluxeowl/lint": "workspace:*",
        "@praha/byethrow-docs": "^0.11.1",
        "@total-typescript/ts-reset": "^0.6.1",
        "dprint": "^0.54.0",
        "eslint": "^10.3.0",
        "jscpd": "^4.0.9",
        "knip": "^6.11.0",
        "oxlint": "^1.62.0",
        "scaffdog": "^4.1.0"
    },
    "scripts": {
        "postinstall": "bun run --filter @deluxeowl/lint build",
        "dev": "tilt up",
        "lint:oxlint": "bun run --workspaces lint:oxlint",
        "lint:eslint": "bun run --workspaces lint:eslint",
        "lint:sg": "ast-grep scan",
        "format:dprint": "dprint fmt",
        "lint:duplicate": "jscpd -c .jscpd.json",
        "typecheck": "bun run --workspaces typecheck",
        "generate": "scaffdog generate",
        "deadcode": "knip",
        "lint:all": "lefthook run pre-push -f",
        "lint:duplicates": "bun run scripts/cli.ts find-duplicate-functions",
        "outdated": "bun outdated --filter '*'",
        "test": "bun run --workspaces --sequential test"
    }
}
