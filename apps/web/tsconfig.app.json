{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "jsx": "react-jsx",
        "lib": [
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ],
        "types": [
            "vite/client",
            "react"
        ],
        "paths": {
            "~/*": [
                "./*"
            ]
        }
    },
    "include": [
        ".",
        "../../reset.d.ts",
        "auto-imports.d.ts"
    ]
}
