{
    "name": "@react-template/server",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "devDependencies": {
        "@types/bun": "^1.3.13",
        "@types/node": "^25.6.0",
        "drizzle-kit": "^0.31.10",
        "vitest": "^4.0.18"
    },
    "peerDependencies": {
        "typescript": "^6.0.3"
    },
    "scripts": {
        "dev": "bun run --no-clear-screen --watch cmd/http.ts",
        "lint:oxlint": "oxlint --fix .",
        "lint:eslint": "eslint --fix .",
        "typecheck": "tsc -b --noEmit",
        "test": "vitest --run --passWithNoTests --reporter=tree",
        "db:generate": "drizzle-kit generate --config ./db/sqlite-drizzle.config.ts",
        "db:migrate": "drizzle-kit migrate --config ./db/sqlite-drizzle.config.ts",
        "db:push": "drizzle-kit push --config ./db/sqlite-drizzle.config.ts",
        "db:ui": "drizzle-kit studio --config ./db/sqlite-drizzle.config.ts"
    },
    "dependencies": {
        "@libsql/client": "^0.17.3",
        "@orpc/openapi": "^1.14.1",
        "@orpc/server": "^1.14.1",
        "@orpc/zod": "^1.14.1",
        "@praha/byethrow": "^0.11.1",
        "@praha/error-factory": "^1.4.1",
        "@react-template/domain": "workspace:*",
        "drizzle-orm": "^0.45.2",
        "ts-pattern": "^5.9.0",
        "zod": "^4.4.3"
    }
}
