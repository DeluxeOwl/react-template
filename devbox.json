{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "bun@latest",
    "commitlint-rs@latest",
    "lefthook@latest",
    "ast-grep@latest",
    "caddy@latest",
    "k3d@latest",
    "tilt@latest"
  ],
  "env": {},
  "shell": {
    "init_hook": [
      "bun install --frozen-lockfile",
      "lefthook install",
      "$PWD/scripts/check-env-setup.sh"
    ],
    "scripts": {}
  }
}
