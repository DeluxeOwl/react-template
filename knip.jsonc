{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreExportsUsedInFile": true,
    // From devbox.json (tsc: TypeScript's, through the workspaces)
    "ignoreBinaries": [
        "tilt",
        "lefthook",
        "tsc"
    ],
    "ignoreDependencies": [
        "@praha/byethrow-docs"
    ],
    "ignore": [
        ".scaffdog/config.js",
        "packages/lint/vendor/**",
        "apps/web/auto-imports.d.ts"
    ],
    "tags": [
        "-lintignore"
    ],
    "workspaces": {
        "apps/server": {
            "entry": [
                "cmd/http.ts",
                "db/sqlite-drizzle.config.ts"
            ]
        },
        "apps/web": {
            "ignoreDependencies": [
                "class-variance-authority",
                "lucide-react",
                "shadcn"
            ]
        },
        "packages/core": {
            "entry": [
                "todos/*.ts"
            ]
        },
        "packages/kernel": {
            "entry": [
                "cqrs/*.ts",
                "ctx/*.ts",
                "test-helpers/*.ts"
            ]
        },
        "packages/lint": {
            "entry": [
                "vendor/better-tailwindcss/tailwindcss/tailwind.async.worker.v{3,4}.js"
            ],
            // vendor/_deps/ requires it through esbuild's `__require(...)`, which knip doesn't read as
            // an import. The vendoring tool checks that vendored imports are declared.
            "ignoreDependencies": [
                "@typescript-eslint/visitor-keys"
            ]
        }
    }
}
